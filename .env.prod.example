# Lodge production environment, read by docker-compose.prod.yml. Copy to `.env.prod`
# (gitignored), replace every CHANGEME, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# In a real deployment these values belong in your secret manager, not a file on disk.
# The app-level keys (Auth__*, Git__*, ...) mean exactly what they do in .env.example.

# --- Lodge server image --- published by .github/workflows/docker-publish.yml; pin a
# version tag in a real deployment. ./scripts/prod-test.sh builds the checkout under this tag.
LODGE_SERVER_IMAGE=ghcr.io/jasoc/lodge:latest
# Where the server is published on the host (put the reverse proxy in front of it).
LODGE_BIND=127.0.0.1
SERVER_PORT=8080
# Inventory/schemas bind mounts (only read with Git__Provider=Local).
LODGE_INVENTORY_DIR=./inventory
LODGE_SCHEMAS_DIR=./schemas

# --- Lodge's Postgres (POSTGRES_HOST/PORT are fixed by the compose file) ---
POSTGRES_DB=lodge
POSTGRES_USER=lodge
POSTGRES_PASSWORD=CHANGEME

# --- Keycloak ---
KEYCLOAK_VERSION=26.4
# Public URL, as reached through the reverse proxy (scheme included, no trailing slash).
KEYCLOAK_HOSTNAME=https://sso.CHANGEME.example
KEYCLOAK_BIND=127.0.0.1
KEYCLOAK_PORT=8081
KEYCLOAK_DB_PASSWORD=CHANGEME
# Bootstrap admin, created on first boot only.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGEME

# --- Auth: SSO through the Keycloak above. Create realm `lodge` and a confidential
# client `lodge` with redirect URI https://<LODGE_HOSTNAME>/api/v1/auth/oidc/callback and a
# "groups" client scope mapping group membership (see docs/deployment/company.md). ---
Auth__Mode=Oidc
Auth__Oidc__Authority=https://sso.CHANGEME.example/realms/lodge
Auth__Oidc__ClientId=lodge
Auth__Oidc__ClientSecret=CHANGEME
Auth__Oidc__Scopes="openid profile email groups"
Auth__Oidc__GroupsClaim=groups
Auth__Oidc__AdminGroup=lodge-admins

# --- Inventory source ---
Git__Provider=GitHub
Git__GitHub__Owner=CHANGEME
Git__GitHub__Repo=CHANGEME
Git__GitHub__Branch=main
Git__GitHub__TokenSecretRef=GITHUB_INVENTORY_TOKEN
GITHUB_INVENTORY_TOKEN=CHANGEME

