{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lodge.dev/schemas/kinds/homelab.instance.schema.json",
  "title": "Homelab Instance",
  "description": "A homelab: Proxmox images and VMs (keyed by hostname, each with the compose files it runs) and Cloudflare DNS zones.",
  "allOf": [
    {
      "$ref": "https://lodge.dev/schemas/common/instance.base.schema.json"
    }
  ],
  "type": "object",
  "required": [
    "proxmox"
  ],
  "properties": {
    "proxmox": {
      "type": "object",
      "required": [
        "virtual_machines"
      ],
      "properties": {
        "virtual_machines": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/virtualMachine"
          }
        },
        "images": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/image"
          }
        }
      }
    },
    "cloudflare": {
      "type": "object",
      "properties": {
        "zones": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/zone"
          }
        }
      }
    }
  },
  "$defs": {
    "virtualMachine": {
      "type": "object",
      "required": [
        "cores",
        "memory_mb",
        "disk_gb",
        "image",
        "ip",
        "gateway"
      ],
      "additionalProperties": false,
      "properties": {
        "node": {
          "type": "string",
          "default": "proxmox"
        },
        "cores": {
          "type": "integer",
          "minimum": 1
        },
        "cpu_type": {
          "type": "string",
          "default": "x86-64-v3"
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 256
        },
        "disk_gb": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "string",
          "description": "Volume id of an already-downloaded cloud image, e.g. vault:import/<file>.qcow2.",
          "pattern": "^[^:]+:import/.+$"
        },
        "datastore": {
          "type": "string",
          "default": "local-lvm"
        },
        "bridge": {
          "type": "string",
          "default": "vmbr0"
        },
        "ip": {
          "type": "string",
          "pattern": "^\\d{1,3}(\\.\\d{1,3}){3}/\\d{1,2}$"
        },
        "gateway": {
          "type": "string",
          "pattern": "^\\d{1,3}(\\.\\d{1,3}){3}$"
        },
        "ansible_profile": {
          "type": "string",
          "description": "A playbook of inventory/homelab/playbooks/ansible/playbooks/, without .yml. The folder is the list of valid names — a schema copy of it would only drift."
        },
        "backed_up": {
          "type": "boolean",
          "description": "Whether the Backrest VM mounts this VM's /volumes export.",
          "default": false
        },
        "compose": {
          "type": "array",
          "description": "Compose files of inventory/homelab/stacks/ to run on this VM (paths or globs).",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "import_id": {
          "type": "string",
          "description": "Adopt an existing VM instead of creating one: <node>/<vm_id>.",
          "pattern": "^[^/]+/\\d+$"
        }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "datastore",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "node": {
          "type": "string"
        },
        "datastore": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "content_type": {
          "type": "string"
        },
        "file_name": {
          "type": "string"
        },
        "import_id": {
          "type": "string"
        }
      }
    },
    "zone": {
      "type": "object",
      "required": [
        "zone_id"
      ],
      "additionalProperties": false,
      "properties": {
        "zone_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "records": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/dnsRecord"
          }
        }
      }
    },
    "dnsRecord": {
      "type": "object",
      "required": [
        "type",
        "name",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "A",
            "AAAA",
            "CNAME",
            "MX",
            "TXT",
            "SRV",
            "CAA",
            "NS"
          ]
        },
        "name": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "ttl": {
          "type": "integer",
          "minimum": 1
        },
        "proxied": {
          "type": "boolean"
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        },
        "import_id": {
          "type": "string",
          "description": "Adopt an existing record: <zone_id>/<record_id>."
        }
      }
    }
  }
}
