{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GitSnapshot": {
    "RepoRoot": ""
  },
  "Git": {
    "Provider": "Local",
    "GitHub": {
      "Owner": "",
      "Repo": "",
      "Branch": "main",
      "TokenSecretRef": "",
      "PollSeconds": 30
    },
    "GoldenPathUrlTemplate": "https://github.com/{owner}/{repo}/blob/{branch}/{path}"
  },
  "Auth": {
    "Mode": "NoAuth",
    "Oidc": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "Scopes": "openid profile email groups",
      "GroupsClaim": "groups",
      "AdminGroup": ""
    }
  },
  "ShellExecutor": {
    "WorkingDirectory": "",
    "LogDirectory": "data/runbook-logs",
    "Runbooks": {
      "acme-ops/provision-service": "./runbooks/provision-service.sh",
      "acme-ops/decommission-service": "./runbooks/decommission-service.sh"
    }
  },
  "WebhookExecutor": {
    "Runbooks": {}
  }
}
