{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lodge.dev/schemas/kinds/acme.instance.schema.json",
  "title": "ACME Instance",
  "description": "Example kind schema shipped with Lodge, extending the shared base. Copy this file as the template for a real kind schema.",
  "allOf": [
    {
      "$ref": "https://lodge.dev/schemas/common/instance.base.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "kind_code": {
      "const": "acme"
    },
    "services": {
      "type": "object",
      "properties": {
        "web": {
          "$ref": "#/$defs/service"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/service"
      }
    },
    "past_history": {
      "type": "array",
      "description": "Explicit facts about what already happened outside Lodge's governance, addressed as signal_path.action_key / signal_path[item_key].action_key / signal_path[item_key].* / the universal '*' marker (description mandatory for that last form).",
      "items": {
        "$ref": "#/$defs/pastHistoryEntry"
      }
    }
  },
  "$defs": {
    "service": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "pastHistoryEntry": {
      "type": "object",
      "required": ["date_utc", "action"],
      "properties": {
        "date_utc": {
          "type": "string",
          "format": "date-time"
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "action": { "const": "*" }
        }
      },
      "then": {
        "required": ["description"],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
