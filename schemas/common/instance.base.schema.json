{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lodge.dev/schemas/common/instance.base.schema.json",
  "title": "Lodge Instance Base",
  "description": "Fields any kind's instance files may provide. None is required: the instance code comes from its folder name, and display_name/generation/region fall back to defaults when absent. When present, they must have these shapes.",
  "type": "object",
  "properties": {
    "kind_code": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "instance": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "region": {
      "type": "string",
      "minLength": 1
    }
  }
}
