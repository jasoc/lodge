{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GitSnapshot": {
    "RepoRoot": ""
  },
  "Git": {
    "Provider": "Local",
    "GitHub": {
      "Owner": "",
      "Repo": "",
      "Branch": "main",
      "TokenSecretRef": "",
      "PollSeconds": 30
    },
    "GoldenPathUrlTemplate": "https://github.com/{owner}/{repo}/blob/{branch}/{path}"
  },
  "Auth": {
    "Mode": "NoAuth",
    "Oidc": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "Scopes": "openid profile email groups",
      "GroupsClaim": "groups",
      "AdminGroup": ""
    }
  },
  "ShellExecutor": {
    "WorkingDirectory": "",
    "LogDirectory": "data/runbook-logs",
    "Runbooks": {}
  },
  "WebhookExecutor": {
    "Runbooks": {}
  },
  "DockerExecutor": {
    "DockerBinaryPath": "docker",
    "LogDirectory": "data/docker-runbook-logs",
    "KeepImagesPerPlaybook": 3
  },
  "Secrets": {
    "Provider": "Env"
  },
  "PassCli": {
    "BinaryPath": "pass-cli",
    "TimeoutSeconds": 30
  }
}
