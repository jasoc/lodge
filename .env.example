# Lodge local (development) environment. Copy to `.env` (gitignored) and adjust if needed —
# ./scripts/run.sh creates this file for you from these defaults if it's missing. The
# production stack reads .env.prod instead (see .env.prod.example).
#
# These are exactly the variable names the app and docker compose both read — nothing
# here gets renamed or remapped by any script. POSTGRES_* match what the official
# postgres image itself expects; the rest are the literal ASP.NET Core config keys
# (Auth__Mode -> Auth:Mode, and so on).

# --- Postgres --- (the docker-compose.yml container, published on localhost:POSTGRES_PORT)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lodge
POSTGRES_USER=lodge
POSTGRES_PASSWORD=lodge

# --- Auth profile: NoAuth (homelab) or Oidc ---
Auth__Mode=NoAuth

# --- Only read when Auth__Mode=Oidc; ignored entirely otherwise. Authority must serve
# {Authority}/.well-known/openid-configuration (Keycloak, Entra ID, Auth0, ... all work).
# GroupsClaim is whichever ID token claim your IdP puts group membership in; AdminGroup
# is the one group name that grants Lodge admin. See docs/deployment/company.md. ---
Auth__Oidc__Authority=
Auth__Oidc__ClientId=
Auth__Oidc__ClientSecret=
Auth__Oidc__Scopes="openid profile email groups"
Auth__Oidc__GroupsClaim=groups
Auth__Oidc__AdminGroup=

# --- Inventory source: Local (reads the working tree) or GitHub ---
Git__Provider=Local
Git__GitHub__Owner=
Git__GitHub__Repo=
Git__GitHub__Branch=main

# --- Reconciliation loop: seconds between full cycles (default 15, minimum 5). Only the
# default: a value saved from the UI's Reconciliation page takes precedence. A finished run
# reconciles its instance right away regardless, so this is the safety net, not the pace.
# Reconciliation__IntervalSeconds=15

# --- Container actions: the docker network they join (default bridge when unset). For
# example the network of docker-compose.yml, so a playbook can reach the dev Postgres by name:
# DockerExecutor__Network=lodge_default
# Named network profiles an action may select with `container: { network: <profile> }`
# (profile -> docker network); `default` is the one above and `none` is built in:
# DockerExecutor__NetworkProfiles__internal=backend_net
# How long a container may run when its action sets no `timeout_seconds` (0 = unlimited):
# DockerExecutor__DefaultTimeoutSeconds=600
# Where containers run: the local socket by default; DOCKER_HOST (the standard docker env
# var, set on the Lodge process itself — never in the inventory) points at another daemon,
# e.g. ssh://user@host. See docs/deployment/containers.md.
# DOCKER_HOST=

# --- Secrets read by Secrets:Provider=Env (the default). The example inventory's playbooks
# are mocks and need none; a kind that declares `{ secret: NAME }` inputs reads NAME from here:
# NAME=
